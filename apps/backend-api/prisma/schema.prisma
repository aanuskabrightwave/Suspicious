// SHIVAM WORK AREA
// apps/backend-api/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum RiskLevel {
  SAFE
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ScanType {
  URL
  QR
  OCR
  APK
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  name          String?
  role          Role           @default(USER)
  devices       Device[]
  scans         Scan[]
  alerts        FamilyAlert[]
  threatLogs    ThreatLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Device {
  id            String   @id @default(uuid())
  name          String
  os            String
  fcmToken      String?
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  lastSync      DateTime @default(now())
}

model Scan {
  id              String    @id @default(uuid())
  target          String
  type            ScanType
  riskScore       Int?
  riskLevel       RiskLevel @default(SAFE)
  confidence      Float?
  explanation     String?
  rawAiResponse   Json?
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  isProcessed     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ThreatLog {
  id          String    @id @default(uuid())
  threatType  String
  severity    RiskLevel
  details     String
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  timestamp   DateTime  @default(now())
}

model FamilyAlert {
  id          String    @id @default(uuid())
  title       String
  message     String
  riskLevel   RiskLevel
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  isRead      Boolean   @default(false)
  timestamp   DateTime  @default(now())
}
