# AYUSH WORK AREA
# Placeholder phishing model file (serialized pickle)
# This file will be replaced with a real trained model after training
# Structure matches what PhishingClassifier expects in get_phishing_classifier()

import pickle
import numpy as np
from sklearn.ensemble import RandomForestClassifier
from sklearn.preprocessing import StandardScaler
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.pipeline import Pipeline
import datetime

# Create a placeholder model structure that matches the expected format
def create_placeholder_phishing_model():
    """
    Creates a placeholder phishing model with the exact structure
    expected by PhishingClassifier.load_model()
    
    This allows the application to start without crashing while
    real models are being trained.
    """
    # Create dummy components that match expected types
    scaler = StandardScaler()
    tfidf = TfidfVectorizer(max_features=100, ngram_range=(1, 2))
    
    # Create a simple Random Forest classifier (same as in PhishingClassifier)
    classifier = RandomForestClassifier(
        n_estimators=10,
        max_depth=5,
        min_samples_split=5,
        min_samples_leaf=2,
        class_weight='balanced',
        random_state=42,
        n_jobs=-1
    )
    
    # Create pipeline (same structure as in PhishingClassifier)
    pipeline = Pipeline([
        ('scaler', scaler),
        ('classifier', classifier)
    ])
    
    # Dummy feature names (matches PhishingClassifier.feature_names)
    feature_names = [
        'url_length', 'num_dots', 'num_hyphens', 'num_underscores',
        'num_slashes', 'num_question_marks', 'num_equals', 'num_percent',
        'num_at_symbols', 'has_ip_address', 'has_https', 'domain_length',
        'path_length', 'num_subdomains', 'has_suspicious_tld', 'num_digits',
        'entropy', 'has_login_keyword', 'has_secure_keyword', 'has_bank_keyword'
    ]
    
    # Create placeholder data
    placeholder_data = {
        'model': pipeline,
        'tfidf': tfidf,
        'feature_names': feature_names,
        'trained_at': datetime.datetime.utcnow().isoformat(),
        'version': '1.0.0-placeholder',
        'description': 'Placeholder phishing model for development. Replace with trained model.'
    }
    
    return placeholder_data

# Generate and save the placeholder model
if __name__ == "__main__":
    model_data = create_placeholder_phishing_model()
    
    # Save to file (this would be done during build process)
    with open('phishing_model.pkl', 'wb') as f:
        pickle.dump(model_data, f)
    
    print("Placeholder phishing model created successfully")
    print(f"Model version: {model_data['version']}")
    print(f"Trained at: {model_data['trained_at']}")